<Project>
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MaydayLanding</RootNamespace>
    <Version Condition="'$(Version)' == ''">0.2.0</Version>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)..\..\..</GameDir>
    <Loader>$(GameDir)\MelonLoader\net6</Loader>
    <Interop>$(GameDir)\MelonLoader\Il2CppAssemblies</Interop>
    <LandingPolicyFile Condition="'$(LandingPolicyFile)' == ''">$(MSBuildThisFileDirectory)Models\candidate.json</LandingPolicyFile>
  </PropertyGroup>
  <!-- Test builds: -p:LandingProbe=true enables probes and auto-recording by default. -->
  <PropertyGroup Condition="'$(LandingProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);LANDING_PROBE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Core/*.cs;../Game/*.cs" />
    <EmbeddedResource Include="../../tools/mayday_landing/feature_names.txt" LogicalName="MaydayLanding.Features" />
    <EmbeddedResource Include="$(LandingPolicyFile)" LogicalName="MaydayLanding.Policy.json" Condition="Exists('$(LandingPolicyFile)')" />
    <Reference Include="MelonLoader" HintPath="$(Loader)\MelonLoader.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(Loader)\0Harmony.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(Loader)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="Il2CppInterop.Common" HintPath="$(Loader)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(Interop)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(Interop)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="Il2CppMirror" HintPath="$(Interop)\Il2CppMirror.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Interop)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(Interop)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(Interop)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="Unity.InputSystem" HintPath="$(Interop)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(Interop)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(Interop)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(Interop)\UnityEngine.UIModule.dll" Private="false" />
  </ItemGroup>
</Project>
